# Joe Perks Platform - Production Environment Template
# Copy this file to config/secrets/production/.env.production and fill in actual values
# NEVER commit actual secrets to version control
# CRITICAL: Use strong, unique secrets for production

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=9000
HOST=0.0.0.0

# Application URLs (Production)
FRONTEND_URL=https://storefront.joeperks.com
ADMIN_URL=https://admin.joeperks.com
ROASTER_PORTAL_URL=https://roaster.joeperks.com
ORGANIZATION_DASHBOARD_URL=https://org.joeperks.com
API_URL=https://api.joeperks.com

# =============================================================================
# DATABASE CONFIGURATION (Supabase Production)
# =============================================================================
DATABASE_URL=postgresql://postgres:[password]@[prod-project-ref].supabase.co:5432/postgres
DATABASE_TYPE=postgres
DATABASE_LOGGING=false

# Supabase Configuration
SUPABASE_URL=https://[prod-project-ref].supabase.co
SUPABASE_ANON_KEY=[production-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[production-service-role-key]

# =============================================================================
# REDIS CONFIGURATION (Production)
# =============================================================================
REDIS_URL=[production-redis-url]
REDIS_TTL=3600

# =============================================================================
# AUTHENTICATION (Stytch Production)
# =============================================================================
STYTCH_PROJECT_ID=[production-stytch-project-id]
STYTCH_SECRET=[production-stytch-secret]
STYTCH_PUBLIC_TOKEN=[production-stytch-public-token]
STYTCH_ENVIRONMENT=live

# JWT Configuration (Production-specific secrets - MUST be unique)
JWT_SECRET=[production-jwt-secret-256-bit-UNIQUE]
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=[production-refresh-secret-256-bit-UNIQUE]
REFRESH_TOKEN_EXPIRES_IN=7d

# =============================================================================
# PAYMENTS (Stripe Live Mode)
# =============================================================================
STRIPE_API_KEY=[production-stripe-secret-key]
STRIPE_PUBLISHABLE_KEY=[production-stripe-publishable-key]
STRIPE_WEBHOOK_SECRET=[production-stripe-webhook-secret]
STRIPE_CONNECT_CLIENT_ID=[production-stripe-connect-client-id]

# =============================================================================
# NOTIFICATIONS (Production)
# =============================================================================
# SendGrid (Email)
SENDGRID_API_KEY=[production-sendgrid-api-key]
SENDGRID_FROM_EMAIL=noreply@joeperks.com
SENDGRID_FROM_NAME="Joe Perks Platform"

# Twilio (SMS)
TWILIO_ACCOUNT_SID=[production-twilio-account-sid]
TWILIO_AUTH_TOKEN=[production-twilio-auth-token]
TWILIO_PHONE_NUMBER=[production-twilio-phone-number]

# =============================================================================
# MEDUSA CONFIGURATION
# =============================================================================
MEDUSA_ADMIN_CORS=https://admin.joeperks.com
MEDUSA_STORE_CORS=https://storefront.joeperks.com,https://admin.joeperks.com,https://roaster.joeperks.com,https://org.joeperks.com
MEDUSA_ADMIN_BACKEND_URL=https://api.joeperks.com

# Cookie settings (Production-specific - MUST be unique)
COOKIE_SECRET=[production-cookie-secret-UNIQUE]
SESSION_SECRET=[production-session-secret-UNIQUE]

# =============================================================================
# MULTI-TENANT CONFIGURATION
# =============================================================================
TENANT_MODE=subdomain
DEFAULT_DOMAIN=joeperks.com
ALLOWED_DOMAINS=joeperks.com

# =============================================================================
# FEATURE FLAGS & SECURITY (Production Hardened)
# =============================================================================
ENABLE_ADMIN_CORS=true
ENABLE_STORE_CORS=true
RATE_LIMIT_MAX=500
RATE_LIMIT_WINDOW=900000

# File Upload (Production limits)
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# PRODUCTION SPECIFIC
# =============================================================================
LOG_LEVEL=warn
ENABLE_SWAGGER=false
ENABLE_PROFILING=false

# Security Headers
ENABLE_HELMET=true
ENABLE_RATE_LIMITING=true
ENABLE_CORS_PROTECTION=true

# =============================================================================
# MONITORING & ALERTING
# =============================================================================
# Add monitoring service configurations here
# DATADOG_API_KEY=[datadog-api-key]
# SENTRY_DSN=[sentry-dsn]

# =============================================================================
# CRITICAL SECURITY NOTES
# =============================================================================
# 1. ALL secrets MUST be unique from dev/staging
# 2. Use 256-bit secrets minimum for JWT and sessions
# 3. Enable all security features in production
# 4. Regular security audits and penetration testing
# 5. Monitor for suspicious activity and failed auth attempts
# 6. Implement proper backup and disaster recovery
# 7. Use separate service accounts with minimal permissions
