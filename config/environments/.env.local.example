# Joe Perks Platform - Local Development Environment Template
# Copy this file to config/secrets/development/.env.local and fill in actual values
# NEVER commit actual secrets to version control

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=9000
HOST=localhost

# Application URLs
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
ROASTER_PORTAL_URL=http://localhost:3002
ORGANIZATION_DASHBOARD_URL=http://localhost:3003
API_URL=http://localhost:9000

# =============================================================================
# DATABASE CONFIGURATION (Supabase)
# =============================================================================
DATABASE_URL=postgresql://postgres:[password]@[project-ref].supabase.co:5432/postgres
DATABASE_TYPE=postgres
DATABASE_LOGGING=true

# Supabase Configuration
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=[your-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[your-service-role-key]

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# =============================================================================
# AUTHENTICATION (Stytch)
# =============================================================================
STYTCH_PROJECT_ID=[your-stytch-project-id]
STYTCH_SECRET=[your-stytch-secret]
STYTCH_PUBLIC_TOKEN=[your-stytch-public-token]
STYTCH_ENVIRONMENT=test

# JWT Configuration
JWT_SECRET=[generate-strong-jwt-secret-256-bit]
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=[generate-strong-refresh-secret-256-bit]
REFRESH_TOKEN_EXPIRES_IN=7d

# =============================================================================
# PAYMENTS (Stripe Connect)
# =============================================================================
STRIPE_API_KEY=[your-stripe-secret-key]
STRIPE_PUBLISHABLE_KEY=[your-stripe-publishable-key]
STRIPE_WEBHOOK_SECRET=[your-stripe-webhook-secret]
STRIPE_CONNECT_CLIENT_ID=[your-stripe-connect-client-id]

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# SendGrid (Email)
SENDGRID_API_KEY=[your-sendgrid-api-key]
SENDGRID_FROM_EMAIL=noreply@joeperks.com
SENDGRID_FROM_NAME="Joe Perks Platform"

# Twilio (SMS)
TWILIO_ACCOUNT_SID=[your-twilio-account-sid]
TWILIO_AUTH_TOKEN=[your-twilio-auth-token]
TWILIO_PHONE_NUMBER=[your-twilio-phone-number]

# =============================================================================
# MEDUSA CONFIGURATION
# =============================================================================
MEDUSA_ADMIN_CORS=http://localhost:7001
MEDUSA_STORE_CORS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
MEDUSA_ADMIN_BACKEND_URL=http://localhost:9000

# Cookie settings
COOKIE_SECRET=[generate-strong-cookie-secret]
SESSION_SECRET=[generate-strong-session-secret]

# =============================================================================
# MULTI-TENANT CONFIGURATION
# =============================================================================
TENANT_MODE=subdomain
DEFAULT_DOMAIN=lvh.me
ALLOWED_DOMAINS=lvh.me,localhost

# =============================================================================
# FEATURE FLAGS & SECURITY
# =============================================================================
ENABLE_ADMIN_CORS=true
ENABLE_STORE_CORS=true
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=900000

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
LOG_LEVEL=debug
ENABLE_SWAGGER=true
ENABLE_PROFILING=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Generate strong secrets using: openssl rand -base64 32
# 2. Use different secrets for each environment
# 3. Rotate secrets regularly (quarterly recommended)
# 4. Never commit actual secrets to version control
# 5. Use environment-specific service accounts
