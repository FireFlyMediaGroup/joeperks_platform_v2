# Joe Perks Platform - Staging Environment Template
# Copy this file to config/secrets/staging/.env.staging and fill in actual values
# NEVER commit actual secrets to version control

# =============================================================================
# CORE APPLICATION SETTINGS
# =============================================================================
NODE_ENV=staging
PORT=9000
HOST=0.0.0.0

# Application URLs (Update with actual staging URLs)
FRONTEND_URL=https://staging-storefront.joeperks.com
ADMIN_URL=https://staging-admin.joeperks.com
ROASTER_PORTAL_URL=https://staging-roaster.joeperks.com
ORGANIZATION_DASHBOARD_URL=https://staging-org.joeperks.com
API_URL=https://staging-api.joeperks.com

# =============================================================================
# DATABASE CONFIGURATION (Supabase Staging)
# =============================================================================
DATABASE_URL=postgresql://postgres:[password]@[staging-project-ref].supabase.co:5432/postgres
DATABASE_TYPE=postgres
DATABASE_LOGGING=false

# Supabase Configuration
SUPABASE_URL=https://[staging-project-ref].supabase.co
SUPABASE_ANON_KEY=[staging-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[staging-service-role-key]

# =============================================================================
# REDIS CONFIGURATION (Staging)
# =============================================================================
REDIS_URL=[staging-redis-url]
REDIS_TTL=3600

# =============================================================================
# AUTHENTICATION (Stytch Staging)
# =============================================================================
STYTCH_PROJECT_ID=[staging-stytch-project-id]
STYTCH_SECRET=[staging-stytch-secret]
STYTCH_PUBLIC_TOKEN=[staging-stytch-public-token]
STYTCH_ENVIRONMENT=test

# JWT Configuration (Staging-specific secrets)
JWT_SECRET=[staging-jwt-secret-256-bit]
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=[staging-refresh-secret-256-bit]
REFRESH_TOKEN_EXPIRES_IN=7d

# =============================================================================
# PAYMENTS (Stripe Test Mode)
# =============================================================================
STRIPE_API_KEY=[staging-stripe-secret-key]
STRIPE_PUBLISHABLE_KEY=[staging-stripe-publishable-key]
STRIPE_WEBHOOK_SECRET=[staging-stripe-webhook-secret]
STRIPE_CONNECT_CLIENT_ID=[staging-stripe-connect-client-id]

# =============================================================================
# NOTIFICATIONS (Staging)
# =============================================================================
# SendGrid (Email)
SENDGRID_API_KEY=[staging-sendgrid-api-key]
SENDGRID_FROM_EMAIL=staging@joeperks.com
SENDGRID_FROM_NAME="Joe Perks Platform (Staging)"

# Twilio (SMS)
TWILIO_ACCOUNT_SID=[staging-twilio-account-sid]
TWILIO_AUTH_TOKEN=[staging-twilio-auth-token]
TWILIO_PHONE_NUMBER=[staging-twilio-phone-number]

# =============================================================================
# MEDUSA CONFIGURATION
# =============================================================================
MEDUSA_ADMIN_CORS=https://staging-admin.joeperks.com
MEDUSA_STORE_CORS=https://staging-storefront.joeperks.com,https://staging-admin.joeperks.com,https://staging-roaster.joeperks.com,https://staging-org.joeperks.com
MEDUSA_ADMIN_BACKEND_URL=https://staging-api.joeperks.com

# Cookie settings (Staging-specific)
COOKIE_SECRET=[staging-cookie-secret]
SESSION_SECRET=[staging-session-secret]

# =============================================================================
# MULTI-TENANT CONFIGURATION
# =============================================================================
TENANT_MODE=subdomain
DEFAULT_DOMAIN=staging.joeperks.com
ALLOWED_DOMAINS=staging.joeperks.com

# =============================================================================
# FEATURE FLAGS & SECURITY
# =============================================================================
ENABLE_ADMIN_CORS=true
ENABLE_STORE_CORS=true
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=900000

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# =============================================================================
# STAGING SPECIFIC
# =============================================================================
LOG_LEVEL=info
ENABLE_SWAGGER=true
ENABLE_PROFILING=false

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 1. Use separate service accounts for staging
# 2. Different secrets from development and production
# 3. Test payment processing in Stripe test mode
# 4. Monitor staging environment for security issues
# 5. Regular security scans and penetration testing
