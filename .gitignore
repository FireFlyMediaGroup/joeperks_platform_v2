# Joe Perks Platform - Git Ignore File

# =============================================================================
# SECURITY - NEVER COMMIT SECRETS
# =============================================================================
# Environment secrets (CRITICAL - NEVER COMMIT)
config/secrets/**/.env*
config/secrets/**/*.env
config/keys/**/*.key
config/keys/**/*.pem
config/keys/**/*.p12
config/keys/**/*.pfx

# Backup files that might contain secrets
*.backup
*.bak
*.tmp

# =============================================================================
# NODE.JS & NPM
# =============================================================================
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories
jspm_packages/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Microbundle cache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# =============================================================================
# NEXT.JS
# =============================================================================
.next/
out/
build/
dist/

# Next.js build output
.next

# Vercel
.vercel

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
# IDEs and editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =============================================================================
# LOGS
# =============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# =============================================================================
# DATABASES
# =============================================================================
# Local database files
*.sqlite
*.sqlite3
*.db

# =============================================================================
# MEDUSA SPECIFIC
# =============================================================================
# Medusa build output
.medusa/
uploads/

# =============================================================================
# TESTING
# =============================================================================
# Jest
coverage/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# =============================================================================
# TEMPORARY FILES
# =============================================================================
# Temporary folders
tmp/
temp/

# =============================================================================
# DOCKER
# =============================================================================
# Docker
.dockerignore
Dockerfile.local

# =============================================================================
# MISC
# =============================================================================
# Nx
.nx/cache

# Turborepo
.turbo

# Local environment variables (keep templates)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# But keep the templates
!config/environments/.env*.example

# =============================================================================
# SECURITY REMINDER
# =============================================================================
# This .gitignore is configured to prevent accidental commits of:
# - Environment secrets and API keys
# - Private keys and certificates
# - Local configuration files
# - Sensitive data files
#
# Always double-check before committing sensitive information!



.nx/workspace-data
.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md
vite.config.*.timestamp*
vitest.config.*.timestamp*